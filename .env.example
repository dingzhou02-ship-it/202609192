# 复制为 .env 后填写；不要提交真实 .env。
# 生成密钥：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# 本地连接用 127.0.0.1；Compose 中使用 postgres。
# 格式：postgresql+psycopg://campus:密码@127.0.0.1:5432/campus
# URL 中含有特殊字符的密码必须进行 URL 编码。
DATABASE_URL=
POSTGRES_USER=campus
POSTGRES_PASSWORD=
POSTGRES_DB=campus
# 仅给 Compose 中的 postgres 管理员使用；必须与业务密码不同，不提供给 web。
POSTGRES_ADMIN_PASSWORD=
# 本地 HTTP 用 false；正式部署启用 HTTPS 后改为 true。
SESSION_COOKIE_SECURE=false
WEB_PORT=8000
# pytest 必须使用独立测试库，库名以 _test 结尾。
TEST_DATABASE_URL=
